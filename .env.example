# ====================================================================
# RADAR SECOP - PLANTILLA DE VARIABLES DE ENTORNO (PRODUCCIÓN VPS)
# Copia este archivo como .env y edita con tus credenciales reales
# ====================================================================

# Dominio y Certificados SSL Automáticos (Caddy)
# Si aún no tienes dominio, puedes usar tu IP pública o :80
DOMAIN=radar.tudominio.com
ACME_EMAIL=admin@tudominio.com

# Puerto del servidor web y API
PORT=3000
NODE_ENV=production

# Base de Datos PostgreSQL 17
PGDATABASE=radar_secop
PGUSER=postgres
PGPASSWORD=cambia_esta_contrasena_por_una_super_segura_2026
PGPORT=5432

# Llave Secreta para Tokens JWT (SaaS Multi-tenant)
JWT_SECRET=genera_un_secreto_aleatorio_muy_largo_para_jwt_seguridad_2026

# Frecuencia del escaneo automático (por defecto: cada hora en el minuto 0)
CRON_SCHEDULE="0 * * * *"

# Token de aplicación opcional de datos.gov.co (aumenta límites de consulta)
SOCRATA_APP_TOKEN=

# Bot de Telegram para notificaciones instantáneas al celular
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# API Key de Google Gemini (Para extracción profunda de pliegos y OCR de RUP)
GEMINI_API_KEY=
